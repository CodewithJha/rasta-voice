# Gnani Speech APIs. Base host from the docs: https://api.vachana.ai
# Every request sends header X-API-Key-ID. Required: the app only calls the
# real Gnani APIs and answers 503 on speech routes when this is empty.
# Never commit a filled-in .env.
GNANI_API_KEY=

GNANI_BASE_URL=https://api.vachana.ai

# rules = keyword extractor (works with no LLM key; also the fallback).
# groq or gemini once issue 02 lands (free tier only).
LLM_PROVIDER=rules
GROQ_API_KEY=
GEMINI_API_KEY=

# In-process desk list cap (issue 04). A restart clears the store. Default 200.
EVENT_STORE_CAPACITY=200
