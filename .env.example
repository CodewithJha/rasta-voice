# Gnani Speech APIs. Base host from the docs: https://api.vachana.ai
# Every request sends header X-API-Key-ID. Required: the app only calls the
# real Gnani APIs and answers 503 on speech routes when this is empty.
# Never commit a filled-in .env.
GNANI_API_KEY=

GNANI_BASE_URL=https://api.vachana.ai

# rules = keyword extractor (works with no LLM key; also the fallback).
# groq or gemini = free-tier LLM, then rules on timeout, 429/5xx, or bad JSON.
LLM_PROVIDER=rules
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional LLM settings. Leave blank to use the defaults in
# backend/rasta/settings.py (model ids checked 12 Nov 2026).
LLM_MODEL=
GROQ_MODEL=
GEMINI_MODEL=
GROQ_BASE_URL=
GEMINI_BASE_URL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_RETRY_BACKOFF_SECONDS=

# Desk event cap (issue 19). Default 200. Oldest rows are evicted on append.
EVENT_STORE_CAPACITY=200

# SQLite path for the dispatch event store (issue 19). Default is
# data/rasta-events.sqlite, relative to the process working directory.
# The running app always uses a file; do not set this to :memory:.
# Free-host disk is ephemeral. A Space rebuild can delete the file.
RASTA_DB_PATH=

# Realtime /api/stream (issue 07). Leave blank to use the defaults in
# backend/rasta/settings.py. CORS_ALLOW_ORIGINS is the same allow list
# issue 27 will use for HTTP CORS and for the WebSocket Origin check.
# Comma-separated exact origins; no wildcards. An empty value denies every
# Origin (production same-origin default once issue 27 sets it that way).
RASTA_MAX_STREAMS=2
RASTA_STREAM_SESSION_SECONDS=900
RASTA_STREAM_IDLE_SECONDS=60
RASTA_STREAM_HEARTBEAT_SECONDS=20
RASTA_STREAM_DRAIN_SECONDS=8
RASTA_STREAM_QUIET_SECONDS=1
RASTA_STREAM_FRAME_BYTES=1024
RASTA_STREAM_QUEUE_MAX=32
RASTA_STREAM_SAMPLE_RATE=16000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared desk passcode (issue 20). Required for GET /api/events and later
# desk writes. Leave this empty here. If it is unset in the process, desk
# routes return 503 and do not fail open. Never put the value in frontend
# source or in a commit.
DISPATCH_PASSCODE=

# Unlock lockout (issue 20). Leave blank to use the defaults in
# backend/rasta/settings.py (5 failures in 600 seconds).
DISPATCH_UNLOCK_MAX_FAILURES=
DISPATCH_UNLOCK_WINDOW_SECONDS=

# Production deploy (issue 13). Leave blank locally (development).
# production requires DISPATCH_PASSCODE and RASTA_ALLOWED_HOSTS, and the
# image default listen port is 7860 (Hugging Face Spaces).
RASTA_ENV=
RASTA_ALLOWED_HOSTS=
RASTA_STATIC_DIR=
# Global Gnani-call budget for public speech routes, per window.
# 0 pauses speech. Unset uses 40 in production and 10000 in development.
RASTA_DEMO_SPEECH_BUDGET=
RASTA_DEMO_SPEECH_WINDOW_SECONDS=
# Per-IP speech requests in a rolling 60-second window.
RASTA_PER_IP_REQUESTS_PER_MINUTE=
# Only enable behind a platform proxy (Spaces/Render). Off by default so
# clients cannot spoof X-Forwarded-For.
RASTA_TRUST_PROXY_HEADERS=
RASTA_MAX_SPEECH_SECONDS=
RASTA_MAX_CONCURRENT_SPEECH=
# Auto-escalate unacked accident_sos (issue 25). Default 60.
SOS_ACK_SECONDS=
# Upstream resilience (issue 29). Leave blank to use the defaults.
RASTA_CONNECT_TIMEOUT_SECONDS=
RASTA_STT_READ_TIMEOUT_SECONDS=
RASTA_TTS_READ_TIMEOUT_SECONDS=
RASTA_BATCH_READ_TIMEOUT_SECONDS=
RASTA_INGEST_DEADLINE_SECONDS=
RASTA_MAX_INFLIGHT=
RASTA_INFLIGHT_WAIT_SECONDS=
RASTA_UPSTREAM_MAX_RETRIES=
RASTA_UPSTREAM_RETRY_BACKOFF_SECONDS=
RASTA_RETRY_AFTER_CAP_SECONDS=
RASTA_BREAKER_FAILURE_THRESHOLD=
RASTA_BREAKER_WINDOW_SECONDS=
RASTA_BREAKER_OPEN_SECONDS=
RASTA_SHUTDOWN_DRAIN_SECONDS=
