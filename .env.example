# Gnani Speech APIs. Base host from the docs: https://api.vachana.ai
# Every request sends header X-API-Key-ID. Leave the key empty until credits arrive.
GNANI_API_KEY=

# 1 = mock STT and TTS even if a key is set (no network).
# 0 = call the live API. Fails if the key is empty.
# unset = mock when GNANI_API_KEY is empty, live when it is set.
GNANI_MOCK=1

GNANI_BASE_URL=https://api.vachana.ai

# mock until issue 02. Then groq or gemini (free tier only).
LLM_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=
